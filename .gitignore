# Built packages
dist/
*.vsix

# Local secrets (the API key belongs in VS Code SecretStorage, never in the repo)
.env
.env.*
*.key

# Raw, unredacted API captures. Only redacted recordings belong in research/live/.
research/live/**/raw/

# Editor and OS noise
.DS_Store
Thumbs.db
.claude/settings.json

# Results from private instances are NOT for this public repo. Run the probes with
# --alias private-<name> (default output lands in research/live/private-*/) or --out private/<...>.
private/
research/live/private-*/
